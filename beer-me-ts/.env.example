# Copy to .env and fill in. Never commit .env.

# MySQL connection string (same database/schema as the original beer.sql)
DATABASE_URL="mysql://root:root@localhost:3306/beer"

# Where the app is served from; used to build links in notification emails
APP_URL="http://localhost:8000"

# SMTP settings for token notification emails.
# Leave SMTP_HOST unset in development to log emails instead of sending them.
# Gmail requires an app password (https://myaccount.google.com/apppasswords);
# a transactional provider (Resend, SendGrid, SES) also works.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Beer Me! <beerme.token@example.com>"

PORT="8000"
