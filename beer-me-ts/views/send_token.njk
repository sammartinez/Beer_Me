{% extends "base.njk" %}

{% block content %}
<header class="bar-header">
    <div class="container">
        <div class="intro-text">
            <div class="row"></div>
        </div>
    </div>
</header>

<div class="container">
    <div class="border-solid">
        <h2 class="section-heading">Send {{ friend.name }} a beer!</h2>

        <form action="/select_bar/{{ user.id }}/{{ friend.id }}" method="post">
            <label for="select_bar">{{ friend.name }}'s favorite bars:</label>
            <select id="select_bar" name="select_bar">
                {% for bar in friendBars %}
                    {% if selectedBar and selectedBar.id == bar.id %}
                        <option selected value="{{ bar.id }}">{{ bar.name }}</option>
                    {% else %}
                        <option value="{{ bar.id }}">{{ bar.name }}</option>
                    {% endif %}
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-warning btn-xs">Select bar</button>
        </form>

        {% if selectedBar %}
        <form action="/add_token/{{ user.id }}/{{ friend.id }}/{{ selectedBar.id }}" method="post">
            <label for="item_id">Here are your drink options for {{ selectedBar.name }}:</label>
            <select id="item_id" name="item_id">
                {% for item in selectedBarItems %}
                    <option value="{{ item.id }}">{{ item.description }} - {{ item.cost }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-warning btn-xs">Send beer token</button>
        </form>
        {% endif %}
    </div>
</div>
{% endblock %}
